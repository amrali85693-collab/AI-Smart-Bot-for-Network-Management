# Copy this file to secrets.toml and fill in your values.
# NEVER commit secrets.toml to git.

GROQ_API_KEY = "your-groq-api-key-here"
GEMINI_API_KEY = "your-gemini-api-key-here"
LLM_PROVIDER = "groq"

# Optional: comma-separated list of hosts/IPs to monitor in Live mode.
# If not set, defaults to: Gateway (192.168.1.1), Google DNS, Cloudflare DNS, etc.
# Example: "192.168.1.1, 192.168.1.10, 8.8.8.8, my-server.example.com"
# MONITORED_HOSTS = "192.168.1.1, 8.8.8.8, 1.1.1.1"
